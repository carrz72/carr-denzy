# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Supabase dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The "publishable" / anon key. Safe to expose in the browser: every table is
# protected by Row Level Security, so this key alone grants nothing.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service role key BYPASSES Row Level Security entirely.
# Server-side only. Never prefix it with NEXT_PUBLIC_. Never import it into a
# file that also has "use client" at the top.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site -----------------------------------------------------------------
# Used for magic-link redirects, canonical URLs, sitemap and OG tags.
# Local: http://localhost:3000   Production: https://carrdenzy.co.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) -------------------------------------------------------
# resend.com → API Keys. Leave blank in development: the app logs the email to
# the terminal instead of sending, so nothing breaks without it.
RESEND_API_KEY=
# Must be an address on a domain you have verified with Resend.
EMAIL_FROM="Carr Denzy <hello@carrdenzy.co.uk>"
# Where new enquiry notifications go.
OWNER_NOTIFICATION_EMAIL=carrdenzy@gmail.com

# --- Owner bootstrap ------------------------------------------------------
# The email address that gets the `owner` role on first sign-in.
# Set this before you sign in for the first time.
OWNER_EMAIL=carrdenzy@gmail.com

# --- Web push -------------------------------------------------------------
# Generate a pair with:  npx web-push generate-vapid-keys
# The public key is baked into the browser bundle at BUILD time, so adding it
# on Vercel needs a redeploy before any device can subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Scheduled reminders --------------------------------------------------
# Guards /api/cron/reminders, which emails customers about overdue invoices and
# expiring quotes. Vercel Cron sends it as a Bearer token; without it the route
# refuses to run rather than let anyone trigger mail to your customers.
# Any long random string will do:  openssl rand -hex 32
CRON_SECRET=
